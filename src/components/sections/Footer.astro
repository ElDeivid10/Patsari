---
import Container from "../layout/Container.astro";
import CoordinateBreadcrumb from "../ui/CoordinateBreadcrumb.astro";
import StatusDot from "../ui/StatusDot.astro";

const columns = [
  {
    title: "Documentación",
    links: [
      { label: "Requisitos técnicos", href: "#" },
      { label: "Pinout del prototipo", href: "#tecnologia" },
      { label: "Formato de la trama", href: "#tecnologia" },
      { label: "Esquemático (PDF)", href: "#" },
      { label: "BOM completo", href: "#" },
    ],
  },
  {
    title: "Bitácora",
    links: [
      { label: "Integración", href: "#proyectos" },
      { label: "Pruebas de banco", href: "#proyectos" },
      { label: "Vuelo de prueba 80 m", href: "#proyectos" },
      { label: "TELEMETRY.CSV ejemplos", href: "#" },
      { label: "Estado de la misión", href: "#mision" },
    ],
  },
  {
    title: "Equipo",
    links: [
      { label: "Integrantes", href: "#" },
      { label: "Cómo unirse", href: "#contacto" },
      { label: "Mentorías disponibles", href: "#contacto" },
      { label: "Calendario de reuniones", href: "#contacto" },
      { label: "Código de conducta", href: "#" },
    ],
  },
];

const regions = [
  { code: "LAB", city: "CDMX · Lab principal", role: "Soldadura · integración · QA" },
  { code: "FLT", city: "Atizapán · campo", role: "Lanzamientos &lt; 100 m" },
  { code: "STR", city: "Querétaro · futura base", role: "Estratosfera &gt; 25 km" },
];
---

<footer class="relative bg-[var(--color-text-primary)] text-[var(--color-surface)] py-16 md:py-20">
  <Container>
    <div class="flex flex-col gap-14">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">
        <div class="lg:col-span-6 flex flex-col gap-6">
          <a href="/" class="flex items-center gap-3">
            <svg viewBox="0 0 28 28" class="w-8 h-8">
              <rect x="3" y="5" width="22" height="18" rx="1.5" fill="none" stroke="#b7cd7f" stroke-width="1.5"></rect>
              <line x1="3" y1="11" x2="25" y2="11" stroke="#b7cd7f" stroke-width="1"></line>
              <line x1="11" y1="5" x2="11" y2="23" stroke="#b7cd7f" stroke-width="0.7"></line>
              <line x1="17" y1="5" x2="17" y2="23" stroke="#b7cd7f" stroke-width="0.7"></line>
              <circle cx="14" cy="16" r="2.5" fill="#b7cd7f"></circle>
              <circle cx="14" cy="16" r="4" fill="none" stroke="#b7cd7f" stroke-width="0.7" opacity="0.7"></circle>
            </svg>
            <div class="flex flex-col leading-none">
              <span class="font-display font-bold text-[1.25rem] tracking-[-0.02em] text-[var(--color-surface)]">
                Patsani
              </span>
              <span class="label-sm text-[var(--color-sage)] mt-1">TEAM 0001 · PROBE v1.0</span>
            </div>
          </a>

          <p class="body-md text-[var(--color-sage)]/80 leading-relaxed max-w-xs">
            Equipo de instrumentación de vuelo. Diseñamos, soldamos y volamos sondas de telemetría para campañas de corta y estratosfera.
          </p>

          <div class="flex flex-col gap-2">
            {regions.map((r) => (
              <div class="flex items-center gap-3 py-1.5">
                <span class="font-mono text-[0.6875rem] font-semibold tracking-[0.1em] text-[var(--color-sage)] border border-[var(--color-sage)]/40 px-2 py-0.5 rounded-xs">
                  {r.code}
                </span>
                <span class="body-sm text-[var(--color-surface)] font-medium" set:html={r.city}></span>
                <span class="text-[var(--color-sage)]/60">·</span>
                <span class="body-sm text-[var(--color-sage)]/80" set:html={r.role}></span>
              </div>
            ))}
          </div>
        </div>

        {columns.map((col) => (
          <div class="lg:col-span-2 flex flex-col gap-4">
            <h4 class="font-mono text-[0.6875rem] font-semibold tracking-[0.1em] uppercase text-[var(--color-sage)]">
              {col.title}
            </h4>
            <ul class="flex flex-col gap-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="body-sm text-[var(--color-surface)]/80 hover:text-[var(--color-sage)] transition-colors duration-150"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-6 pt-8 border-t border-[var(--color-sage)]/20">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex items-center gap-2">
            <StatusDot variant="telemetry" size="sm" pulse />
            <span class="label-sm text-[var(--color-sage)]">MISSION STATE · WAIT</span>
          </div>
          <div class="h-3 w-px bg-[var(--color-sage)]/30"></div>
          <span class="label-sm text-[var(--color-sage)]/80">© 2026 Patsani Team 0001</span>
          <span class="label-sm text-[var(--color-sage)]/60">·</span>
          <span class="label-sm text-[var(--color-sage)]/80">Documentación bajo CC-BY-SA 4.0</span>
        </div>

        <div class="flex items-center gap-4">
          <CoordinateBreadcrumb
            segments={["PAT", "TEAM-0001", "BUILD-2026.04.14"]}
            variant="inverse"
            size="md"
          />
        </div>
      </div>
    </div>
  </Container>
</footer>
