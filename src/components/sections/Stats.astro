---
import Container from "../layout/Container.astro";
import SectionHeader from "../layout/SectionHeader.astro";
import MetricTile from "../ui/MetricTile.astro";

const metrics = [
  {
    label: "Frecuencia de transmisión",
    value: "1.00",
    numericValue: 1,
    suffix: "Hz",
    decimals: 2,
    delta: "Estable · millis()",
    status: "nominal" as const,
    code: "SPEC/TX-001",
  },
  {
    label: "Campos por paquete",
    value: "21",
    numericValue: 21,
    delta: "10 obligatorios + 11 secundarios",
    status: "nominal" as const,
    code: "SPEC/FRM-002",
  },
  {
    label: "Sensores activos",
    value: "4",
    numericValue: 4,
    delta: "BNO085 · BME688 · GPS · VBat",
    status: "nominal" as const,
    code: "SPEC/SNS-003",
  },
  {
    label: "Buses compartidos",
    value: "2",
    numericValue: 2,
    delta: "I²C + SPI multiplexado",
    status: "nominal" as const,
    code: "SPEC/BUS-004",
  },
];
---

<section class="relative py-20 md:py-24 bg-[var(--color-surface-container-low)] border-y border-[var(--color-border)]">
  <Container>
    <div class="flex flex-col gap-12">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <SectionHeader
            code="ESPECIFICACIÓN"
            title="Parámetros verificados del prototipo PROBE-01"
            description="Estos valores se verifican en banco antes de cada campaña de vuelo contra el manual de requisitos. Cualquier desviación invalida el pase de integración."
          />
        </div>
        <div class="lg:col-span-5 flex flex-col gap-2">
          <div class="flex items-center justify-end gap-2">
            <span class="label-sm text-[var(--color-text-muted)]">Build</span>
            <span class="label-sm text-[var(--color-text-primary)] font-medium">v1.0 · 2026-04-14</span>
          </div>
          <div class="flex items-center justify-end gap-2">
            <span class="label-sm text-[var(--color-text-muted)]">TEAM_ID</span>
            <span class="label-sm text-[var(--color-text-primary)] font-medium">0001</span>
          </div>
          <div class="flex items-center justify-end gap-2">
            <span class="label-sm text-[var(--color-text-muted)]">Estado de integración</span>
            <span class="label-sm text-[var(--color-primary-hover)] font-medium">WAIT · listo para vuelo</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {metrics.map((m) => (
          <MetricTile
            label={m.label}
            value={m.value}
            numericValue={m.numericValue}
            decimals={m.decimals}
            suffix={m.suffix}
            delta={m.delta}
            status={m.status}
            code={m.code}
          />
        ))}
      </div>
    </div>
  </Container>
</section>
