---
import Container from "../layout/Container.astro";
import SectionHeader from "../layout/SectionHeader.astro";
import Badge from "../ui/Badge.astro";
import CornerBracket from "../visuals/CornerBracket.astro";
import TelemetrySparkline from "../visuals/TelemetrySparkline.astro";

interface Project {
  code: string;
  sector: string;
  title: string;
  client: string;
  region: string;
  duration: string;
  description: string;
  metrics: { label: string; value: string; direction: "up" | "down" | "flat" }[];
  status: "nominal" | "telemetry";
  progress: number;
  tags: string[];
}

const projects: Project[] = [
  {
    code: "TEST-04",
    sector: "Integración de hardware",
    title: "Soldadura y verificación de buses I²C + SPI en PROBE-01",
    client: "Bench interno",
    region: "Lab · CDMX",
    duration: "2026-03-08 → 03-22",
    description: "Soldamos los seis módulos sobre placa prototipo, verificamos direccionamiento I²C con scanner, continuidad de SPI compartido entre LoRa y SD, y respuesta de cada pin con multímetro y osciloscopio.",
    metrics: [
      { label: "Módulos soldados", value: "6/6", direction: "up" },
      { label: "I²C scan", value: "0x28 · 0x77", direction: "flat" },
      { label: "SPI loopback", value: "OK", direction: "flat" },
    ],
    status: "nominal",
    progress: 100,
    tags: ["I²C", "SPI", "BNO085", "BME688"],
  },
  {
    code: "TEST-02",
    sector: "Pruebas de banco",
    title: "Validación de la trama CSV contra especificación del reglamento",
    client: "Code review + bench",
    region: "Reproductor serial",
    duration: "2026-03-23 → 04-02",
    description: "Corrimos el firmware en banco durante 8 horas, capturamos la salida serial y validamos que los 21 campos respeten orden, precisión (1 decimal en ALT/TEMP, 2 en VOLT/AX/AY/AZ) y códigos de estado.",
    metrics: [
      { label: "Paquetes", value: "28,804", direction: "up" },
      { label: "Drift Mission Clock", value: "+0.4s", direction: "down" },
      { label: "Packets SD = LoRa", value: "100%", direction: "flat" },
    ],
    status: "nominal",
    progress: 100,
    tags: ["CSV", "Bench", "Validación"],
  },
  {
    code: "TEST-06",
    sector: "Vuelo de prueba",
    title: "Caída libre controlada desde 80 m con apertura de paracaídas",
    client: "Campo de pruebas",
    region: "Atizapán · 19.40°N",
    duration: "2026-04-12",
    description: "Lanzamiento de PROBE-01 desde torre de 80 metros con paracaídas accionado a 30 m. Registramos transición WAIT → DESC y posterior estabilización en LAND; telemetría completa en SD y ground station.",
    metrics: [
      { label: "Apogeo registrado", value: "78.4 m", direction: "up" },
      { label: "T. a LAND", value: "00:01:18", direction: "flat" },
      { label: "Pérdida de paquetes", value: "0.06%", direction: "down" },
    ],
    status: "telemetry",
    progress: 92,
    tags: ["Vuelo", "Paracaídas", "LAND"],
  },
];
---

<section id="proyectos" class="relative py-20 md:py-28 bg-[var(--color-surface-container-low)] border-y border-[var(--color-border)]">
  <Container>
    <div class="flex flex-col gap-14">
      <SectionHeader
        code="BITÁCORA"
        title="Campañas de integración y vuelo de PROBE-01"
        description="Tres campañas documentadas con métricas reales: integración en banco, validación de trama y vuelo de prueba desde torre. La siguiente campaña apunta al lanzamiento estratosférico."
      />

      <div class="grid lg:grid-cols-3 gap-6">
        {projects.map((proj) => (
          <article class="group relative bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg flex flex-col hover:border-[var(--color-border-active)] transition-all duration-200 hover:shadow-elevated">
            <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
              <CornerBracket position="tr" />
            </div>
            <div class="absolute bottom-3 left-3 opacity-0 group-hover:opacity-100 transition-opacity">
              <CornerBracket position="bl" />
            </div>

            <header class="flex items-center justify-between px-6 py-4 border-b border-[var(--color-border)]">
              <div class="flex items-center gap-3 min-w-0">
                <span class="label-sm text-[var(--color-text-muted)] tracking-[0.12em] flex-shrink-0">[{proj.code}]</span>
                <div class="h-3 w-px bg-[var(--color-border)] flex-shrink-0"></div>
                <span class="label-sm text-[var(--color-text-secondary)] truncate">{proj.sector}</span>
              </div>
              <Badge variant={proj.status} size="sm">
                {proj.status === "nominal" ? "Validado" : "Live"}
              </Badge>
            </header>

            <div class="flex flex-col gap-4 px-6 pt-5 flex-1">
              <h3 class="font-display font-semibold text-[1.125rem] leading-[1.4] tracking-[-0.01em] text-[var(--color-text-primary)]">
                {proj.title}
              </h3>
              <p class="body-md text-[var(--color-text-secondary)] leading-relaxed">
                {proj.description}
              </p>

              <dl class="grid grid-cols-3 gap-2 py-3 mt-2">
                {proj.metrics.map((m) => (
                  <div class="flex flex-col gap-1 border-l border-[var(--color-border)] first:border-l-0 pl-3 first:pl-0">
                    <dt class="label-sm text-[var(--color-text-muted)]">{m.label}</dt>
                    <dd class="telemetry-num text-[var(--color-text-primary)] tabular-nums text-[1rem] flex items-center gap-1">
                      {m.value}
                      <span class={`text-[0.625rem] ${m.direction === "down" ? "text-[var(--color-primary-hover)]" : m.direction === "up" ? "text-[var(--color-primary-hover)]" : "text-[var(--color-text-muted)]"}`}>
                        {m.direction === "up" ? "↑" : m.direction === "down" ? "↓" : "—"}
                      </span>
                    </dd>
                  </div>
                ))}
              </dl>

              <div class="h-10 -mx-1 mt-1">
                <TelemetrySparkline variant="primary" data={[42, 48, 45, 52, 49, 55, 58, 62, 65, 68, 72, 75, 78, 82, 85, 88, 92]} />
              </div>
            </div>

            <footer class="px-6 py-4 mt-4 border-t border-[var(--color-border)] bg-[var(--color-surface-container-low)]/50 flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <span class="label-sm text-[var(--color-text-muted)]">Avance</span>
                <span class="label-sm text-[var(--color-text-primary)] font-medium">{proj.progress}%</span>
              </div>
              <div class="h-1 bg-[var(--color-surface-sunk)] rounded-xs overflow-hidden border border-[var(--color-border)]">
                <div
                  class="h-full bg-gradient-to-r from-[var(--color-primary-hover)] to-[var(--color-sage)] transition-all duration-1000"
                  style={`width: ${proj.progress}%`}
                ></div>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-1">
                {proj.tags.map((tag) => (
                  <span class="label-sm text-[var(--color-text-secondary)] bg-[var(--color-surface-sunk)] border border-[var(--color-border)] px-2 py-0.5 rounded-xs">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex items-center justify-between pt-2 text-[var(--color-text-muted)]">
                <span class="label-sm">{proj.client}</span>
                <span class="label-sm">{proj.duration}</span>
              </div>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>
