---
import Container from "../layout/Container.astro";
import SectionHeader from "../layout/SectionHeader.astro";
import Input from "../ui/Input.astro";
import Button from "../ui/Button.astro";
import Badge from "../ui/Badge.astro";
import CoordinateBreadcrumb from "../ui/CoordinateBreadcrumb.astro";
import StatusDot from "../ui/StatusDot.astro";
---

<section id="contacto" class="relative py-20 md:py-28 bg-[var(--color-surface-container-low)] border-y border-[var(--color-border)]">
  <Container>
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-5 flex flex-col gap-7">
        <SectionHeader
          code="CONTACTO"
          title="Iniciar una conversación técnica"
          description="Respondemos consultas de agencias, operadores, investigadores y equipos de producto. La primera llamada es siempre con un ingeniero."
        />

        <div class="flex flex-col gap-4">
          <div class="flex items-start gap-3 p-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md hover:border-[var(--color-border-active)] transition-colors">
            <div class="flex flex-col gap-1 flex-1">
              <span class="label-sm text-[var(--color-text-secondary)]">Consola operativa</span>
              <span class="body-md text-[var(--color-text-primary)] font-medium">console.patsani.io</span>
              <span class="body-sm text-[var(--color-text-muted)]">Acceso SSO + 2FA · SAML / OIDC</span>
            </div>
            <Badge variant="nominal" withDot size="sm">ONLINE</Badge>
          </div>

          <div class="flex items-start gap-3 p-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md">
            <div class="flex flex-col gap-1 flex-1">
              <span class="label-sm text-[var(--color-text-secondary)]">Correo directo</span>
              <span class="body-md text-[var(--color-text-primary)] font-medium">ops@patsani.io</span>
              <span class="body-sm text-[var(--color-text-muted)]">Cifrado PGP · Key fingerprint 4D9A…E2C1</span>
            </div>
          </div>

          <div class="flex items-start gap-3 p-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md">
            <div class="flex flex-col gap-1 flex-1">
              <span class="label-sm text-[var(--color-text-secondary)]">Operación 24/7</span>
              <span class="body-md text-[var(--color-text-primary)] font-medium">+52 55 8421 6630</span>
              <span class="body-sm text-[var(--color-text-muted)]">NOC · respuesta &lt; 15 min para SLA enterprise</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <StatusDot variant="telemetry" size="md" pulse ring />
          <div class="flex flex-col">
            <span class="label-sm text-[var(--color-text-primary)] font-medium">NOC respondiendo</span>
            <span class="body-sm text-[var(--color-text-muted)]">Turno actual · MX-02 / CL-01</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form class="bg-[var(--color-surface)] border border-[var(--color-border-active)]/40 rounded-lg p-7 md:p-9 flex flex-col gap-6 shadow-elevated relative">
          <div class="absolute top-3 right-3">
            <Badge variant="telemetry" size="sm">FORM // 0xA4</Badge>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-[var(--color-border)]">
            <CoordinateBreadcrumb segments={["PATSANI", "FORM", "CONTACT", "NEW-REQ"]} />
            <span class="label-sm text-[var(--color-text-muted)]">TS · auto</span>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <Input label="Nombre completo" name="name" placeholder="Ada Lovelace" required />
            <Input label="Organización" name="org" placeholder="Agencia / Empresa" required />
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <Input label="Correo" name="email" type="email" placeholder="ada@example.org" required suffix="@" />
            <Input label="Rol" name="role" placeholder="Director de programa" />
          </div>

          <Input label="Sitio / Coordenadas del proyecto" name="location" placeholder="-34.6, -58.4" prefix="LAT/LON" />

          <Input
            label="Descripción breve"
            name="message"
            placeholder="Cuéntenos sobre la misión, sensores requeridos y plazos."
            multiline
            rows={4}
            required
          />

          <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-[var(--color-border)]">
            <div class="flex items-center gap-2 text-[var(--color-text-muted)]">
              <span class="label-sm">Cifrado</span>
              <span class="label-sm text-[var(--color-primary-hover)] font-medium">TLS 1.3</span>
              <span class="text-[var(--color-border)]">·</span>
              <span class="label-sm text-[var(--color-primary-hover)] font-medium">AES-256-GCM</span>
            </div>
            <Button variant="primary" size="lg" type="submit">
              <span>Transmitir solicitud</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
              </svg>
            </Button>
          </div>
        </form>
      </div>
    </div>
  </Container>
</section>
