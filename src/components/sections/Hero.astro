---
import Button from "../ui/Button.astro";
import Badge from "../ui/Badge.astro";
import Container from "../layout/Container.astro";
import GridPattern from "../visuals/GridPattern.astro";
import CornerBracket from "../visuals/CornerBracket.astro";
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <GridPattern size={48} opacity={0.45} />
  </div>

  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--color-border)] to-transparent"></div>

  <Container>
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-7">
        <div class="flex items-center gap-3 flex-wrap">
          <Badge variant="nominal" withDot>Sistema de telemetría</Badge>
          <span class="label-sm text-[var(--color-text-muted)]">TEAM_ID · 0001 · Prototipo v1.0</span>
        </div>

        <h1 class="font-display font-bold text-[2.5rem] md:text-[3.25rem] md:leading-[3.4rem] lg:text-[3.75rem] lg:leading-[3.8rem] tracking-[-0.035em] text-[var(--color-text-primary)]">
          Sonda de telemetría
          <span class="relative inline-block">
            <span class="relative z-10">para misiones estratosféricas</span>
            <span class="absolute bottom-1.5 left-0 right-0 h-2.5 bg-[var(--color-sage)]/40 -z-0"></span>
          </span>
        </h1>

        <p class="body-lg text-[var(--color-text-secondary)] max-w-xl">
          Plataforma embebida basada en Arduino Nano ESP32 con sensores inerciales, ambientales y GPS. Transmite una trama CSV de 21 campos a 1 Hz por LoRa, con registro redundante en microSD y máquina de estados de vuelo.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <Button variant="primary" size="lg" href="#tecnologia">
            <span>Ver esquemático</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
            </svg>
          </Button>
          <Button variant="secondary" size="lg" href="#contacto">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2 3h10v8H2z M2 3l5 4 5-4" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linejoin="round"></path>
            </svg>
            <span>Hablar con el equipo</span>
          </Button>
        </div>

        <div class="flex flex-wrap items-stretch gap-0 mt-2 border border-[var(--color-border)] rounded-lg overflow-hidden bg-[var(--color-surface)]">
          <div class="flex items-center gap-3 px-4 py-3 border-r border-[var(--color-border)] flex-1 min-w-[180px]">
            <div class="flex flex-col gap-1 flex-1">
              <span class="label-sm text-[var(--color-text-secondary)]">Frecuencia TX</span>
              <span class="telemetry-num text-[var(--color-text-primary)] tabular-nums">1.00 Hz</span>
            </div>
            <Badge variant="telemetry" size="sm">LIVE</Badge>
          </div>
          <div class="flex items-center gap-3 px-4 py-3 border-r border-[var(--color-border)] flex-1 min-w-[180px]">
            <div class="flex flex-col gap-1 flex-1">
              <span class="label-sm text-[var(--color-text-secondary)]">Trama CSV</span>
              <span class="telemetry-num text-[var(--color-text-primary)] tabular-nums">21 campos</span>
            </div>
            <Badge variant="nominal" size="sm" withDot>OK</Badge>
          </div>
          <div class="flex items-center gap-3 px-4 py-3 flex-1 min-w-[180px]">
            <div class="flex flex-col gap-1 flex-1">
              <span class="label-sm text-[var(--color-text-secondary)]">Estado misión</span>
              <span class="telemetry-num text-[var(--color-text-primary)] tabular-nums">WAIT → DESC</span>
            </div>
            <Badge variant="standby" size="sm">STBY</Badge>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="absolute -top-4 -right-4 z-10">
          <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-sm px-3 py-2 flex items-center gap-2 shadow-elevated">
            <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary-hover)] anim-pulse-dot"></div>
            <span class="label-sm text-[var(--color-text-secondary)]">PROBE-01 / POWER OK</span>
          </div>
        </div>
        <div class="absolute -bottom-3 -left-3 z-10 hidden md:block">
          <div class="bg-[var(--color-text-primary)] border border-[var(--color-text-primary)] rounded-sm px-3 py-2 flex items-center gap-2 shadow-elevated">
            <span class="label-sm text-[var(--color-sage)] font-mono">SN</span>
            <span class="label-sm text-[var(--color-surface)] font-mono">PAT-0001-A</span>
          </div>
        </div>

        <div class="relative bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg p-6 md:p-8 shadow-elevated">
          <div class="absolute top-2.5 left-2.5">
            <CornerBracket position="tl" />
          </div>
          <div class="absolute top-2.5 right-2.5">
            <CornerBracket position="tr" />
          </div>
          <div class="absolute bottom-2.5 left-2.5">
            <CornerBracket position="bl" />
          </div>
          <div class="absolute bottom-2.5 right-2.5">
            <CornerBracket position="br" />
          </div>

          <div class="probe-image-wrap relative w-full max-w-[420px] mx-auto aspect-[2/3]">
            <div class="probe-ambient absolute inset-0 pointer-events-none" aria-hidden="true"></div>
            <img
              src="/Cuerpo.png"
              alt="Render 3D del cuerpo del PROBE-01 con estructura honeycomb"
              class="probe-image relative w-full h-full object-contain cursor-pointer"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .probe-image-wrap {
    filter:
      drop-shadow(0 0 18px rgba(183, 205, 127, 0.35))
      drop-shadow(0 6px 24px rgba(40, 62, 6, 0.28))
      drop-shadow(0 18px 48px rgba(59, 81, 16, 0.22));
    transition: filter 0.4s ease;
  }

  .probe-ambient {
    background: radial-gradient(
      ellipse 60% 70% at 50% 55%,
      rgba(183, 205, 127, 0.18) 0%,
      rgba(59, 81, 16, 0.08) 45%,
      transparent 75%
    );
  }

  .probe-image {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }

  .probe-image-wrap:hover .probe-image {
    transform: scale(1.06);
  }

  .probe-image-wrap:hover {
    filter:
      drop-shadow(0 0 28px rgba(183, 205, 127, 0.55))
      drop-shadow(0 8px 32px rgba(40, 62, 6, 0.35))
      drop-shadow(0 22px 60px rgba(59, 81, 16, 0.3));
  }

  @media (prefers-reduced-motion: reduce) {
    .probe-image {
      transition: none;
    }
    .probe-image-wrap:hover .probe-image {
      transform: none;
    }
  }
</style>
