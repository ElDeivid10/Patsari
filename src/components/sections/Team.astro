---
import Container from "../layout/Container.astro";
import Badge from "../ui/Badge.astro";
import StatusDot from "../ui/StatusDot.astro";

interface Member {
  name: string;
  role: string;
  specialties: string[];
  initials: string;
  contribution: string;
  badge: string;
  badgeVariant: "nominal" | "telemetry" | "standby";
}

const team: Member[] = [
  {
    name: "David Antonio Vargas Lozuna",
    role: "Ingeniero en Sistemas Computacionales",
    specialties: ["Frontend", "Hardware"],
    initials: "DV",
    contribution: "Líder de frontend y firmware",
    badge: "FRONTEND · HW",
    badgeVariant: "nominal",
  },
  {
    name: "Juan Eduardo Rojas Rivas",
    role: "Ingeniero en Sistemas Computacionales",
    specialties: ["Hardware", "Fullstack"],
    initials: "JR",
    contribution: "Integración de buses y backend",
    badge: "HARDWARE · FS",
    badgeVariant: "nominal",
  },
  {
    name: "Jaime Corza",
    role: "Ingeniero en Sistemas Computacionales",
    specialties: ["Diseño 3D"],
    initials: "JC",
    contribution: "Carcasa y mecánica del PROBE-01",
    badge: "DISEÑO 3D",
    badgeVariant: "standby",
  },
  {
    name: "Ariadna Deyanira Soto Zaragoza",
    role: "Ingeniera en Sistemas Computacionales",
    specialties: ["Diseño 3D"],
    initials: "AS",
    contribution: "Modelo mecánico y paracaídas",
    badge: "DISEÑO 3D",
    badgeVariant: "standby",
  },
  {
    name: "Aldo",
    role: "Ingeniero Electrónico",
    specialties: ["Circuitos"],
    initials: "A",
    contribution: "Diseño del PCB y divisor de batería",
    badge: "CIRCUITOS",
    badgeVariant: "telemetry",
  },
];
---

<section
  id="equipo"
  class="relative py-20 md:py-28 bg-[var(--color-text-primary)] text-[var(--color-surface)] border-y border-[var(--color-border)] overflow-hidden"
  role="region"
  aria-roledescription="carousel"
  aria-label="Equipo de desarrollo"
>
  <div
    class="absolute inset-0 opacity-[0.07] pointer-events-none"
    style="background-image: linear-gradient(to right, rgba(183,205,127,0.4) 1px, transparent 1px), linear-gradient(to bottom, rgba(183,205,127,0.4) 1px, transparent 1px); background-size: 48px 48px;"
  ></div>

  <Container class="relative">
    <div class="flex flex-col gap-12">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <header class="flex flex-col gap-6 items-start">
            <div class="flex items-center gap-3">
              <span class="label-sm text-[var(--color-sage)] tracking-[0.12em]">[EQUIPO]</span>
              <div class="h-px w-12 bg-[var(--color-sage)]/30"></div>
            </div>
            <h2 class="headline-lg md:text-[2.25rem] md:leading-[2.5rem] text-[var(--color-surface)] max-w-3xl">
              Las personas que soldaron, programaron y volaron el PROBE-01
            </h2>
            <p class="body-lg text-[var(--color-sage)]/85 max-w-2xl">
              Cinco ingenieros detrás del prototipo: instrumentación, firmware, frontend y mecánica.
            </p>
          </header>
        </div>
        <div class="lg:col-span-5 flex flex-wrap items-center gap-3 lg:justify-end">
          <div class="flex items-center gap-2 px-2.5 h-8 bg-[var(--color-surface)]/5 border border-[var(--color-sage)]/20 rounded-sm">
            <StatusDot variant="telemetry" size="sm" pulse />
            <span class="label-sm text-[var(--color-sage)] tracking-[0.08em]">5 / 5 INTEGRANTES</span>
          </div>
          <Badge variant="nominal" withDot>TEAM 0001</Badge>
        </div>
      </div>

      <div class="relative" data-team-carousel>
        <button
          type="button"
          class="team-prev absolute left-0 top-1/2 -translate-y-1/2 z-10 -translate-x-1/2 md:-translate-x-3 w-11 h-11 rounded-full border border-[var(--color-sage)]/30 bg-[var(--color-text-primary)] text-[var(--color-sage)] hover:border-[var(--color-sage)] hover:bg-[var(--color-sage)]/10 transition-all flex items-center justify-center disabled:opacity-30 disabled:cursor-not-allowed focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-sage)]"
          aria-label="Integrante anterior"
          data-team-prev
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M10 2 L4 8 L10 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
          </svg>
        </button>

        <button
          type="button"
          class="team-next absolute right-0 top-1/2 -translate-y-1/2 z-10 translate-x-1/2 md:translate-x-3 w-11 h-11 rounded-full border border-[var(--color-sage)]/30 bg-[var(--color-text-primary)] text-[var(--color-sage)] hover:border-[var(--color-sage)] hover:bg-[var(--color-sage)]/10 transition-all flex items-center justify-center disabled:opacity-30 disabled:cursor-not-allowed focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-sage)]"
          aria-label="Siguiente integrante"
          data-team-next
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M6 2 L12 8 L6 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
          </svg>
        </button>

        <ul
          class="team-track flex gap-5 overflow-x-auto pb-2 snap-x snap-mandatory scroll-smooth"
          style="scrollbar-width: none; -ms-overflow-style: none;"
          data-team-track
        >
          {team.map((m, i) => (
            <li
              class="team-card snap-center shrink-0 w-[88%] sm:w-[58%] md:w-[44%] lg:w-[32%] xl:w-[30%]"
              data-team-card={i}
              aria-label={`${i + 1} de ${team.length}: ${m.name}`}
            >
              <article class="group relative h-full bg-[var(--color-surface)]/5 border border-[var(--color-sage)]/20 rounded-lg p-7 flex flex-col gap-5 hover:border-[var(--color-sage)]/60 hover:bg-[var(--color-surface)]/8 transition-all duration-300 data-[active=true]:border-[var(--color-sage)] data-[active=true]:bg-[var(--color-surface)]/10 data-[active=true]:scale-[1.02] data-[active=true]:shadow-[0_8px_32px_-8px_rgba(183,205,127,0.25)]">
                <header class="flex items-start justify-between gap-3">
                  <div
                    class="relative w-16 h-16 rounded-full bg-gradient-to-br from-[var(--color-primary-hover)] to-[var(--color-primary-deep)] border border-[var(--color-sage)]/40 flex items-center justify-center flex-shrink-0"
                    aria-hidden="true"
                  >
                    <span class="font-display font-bold text-[1.25rem] tracking-tight text-[var(--color-surface)]">
                      {m.initials}
                    </span>
                    <span class="absolute -bottom-0.5 -right-0.5 w-4 h-4 rounded-full bg-[var(--color-sage)] border-2 border-[var(--color-text-primary)] flex items-center justify-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-text-primary)] anim-pulse-dot"></span>
                    </span>
                  </div>
                  <Badge variant={m.badgeVariant} size="sm">{m.badge}</Badge>
                </header>

                <div class="flex flex-col gap-2 flex-1">
                  <h3 class="font-display font-semibold text-[1.0625rem] leading-snug tracking-[-0.01em] text-[var(--color-surface)]">
                    {m.name}
                  </h3>
                  <p class="body-sm text-[var(--color-sage)]/85 leading-relaxed font-mono">
                    {m.role}
                  </p>
                </div>

                <div class="flex flex-col gap-3 pt-4 border-t border-[var(--color-sage)]/15">
                  <div class="flex items-start gap-2">
                    <span class="label-sm text-[var(--color-sage)]/60 mt-0.5 tracking-[0.08em]">CONTRIBUCIÓN</span>
                  </div>
                  <p class="body-md text-[var(--color-surface)]/85 leading-relaxed">
                    {m.contribution}
                  </p>
                </div>

                <footer class="flex flex-wrap gap-1.5 pt-1">
                  {m.specialties.map((s) => (
                    <span class="label-sm text-[var(--color-sage)] border border-[var(--color-sage)]/30 bg-[var(--color-sage)]/5 px-2 py-0.5 rounded-xs">
                      {s}
                    </span>
                  ))}
                </footer>

                <div class="absolute top-2.5 right-2.5 opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M1 1 L 1 5 M 1 1 L 5 1" stroke="#b7cd7f" stroke-width="1" stroke-linecap="square"></path>
                  </svg>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-5 pt-2 border-t border-[var(--color-sage)]/15">
        <div class="flex items-center gap-3 order-2 sm:order-1">
          <span class="label-sm text-[var(--color-sage)]/60 tracking-[0.08em]">EQUIPO</span>
          <span class="font-mono text-[var(--color-surface)] tabular-nums" data-team-current>1</span>
          <span class="font-mono text-[var(--color-sage)]/40">/</span>
          <span class="font-mono text-[var(--color-sage)]/60 tabular-nums">{team.length.toString().padStart(2, "0")}</span>
        </div>

        <ol class="flex items-center gap-2 order-1 sm:order-2" data-team-dots>
          {team.map((_, i) => (
            <li>
              <button
                type="button"
                class="team-dot w-8 h-1.5 rounded-full bg-[var(--color-sage)]/20 hover:bg-[var(--color-sage)]/40 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-sage)] data-[active=true]:bg-[var(--color-sage)] data-[active=true]:w-12"
                aria-label={`Ir al integrante ${i + 1}`}
                data-team-dot={i}
              ></button>
            </li>
          ))}
        </ol>

        <div class="hidden sm:flex items-center gap-2 label-sm text-[var(--color-sage)]/60 order-3">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 6 L 8 6 M 5 3 L 3 6 L 5 9 M 9 9 L 7 9" stroke="currentColor" stroke-width="0.8" stroke-linecap="square"></path>
          </svg>
          <span class="tracking-[0.08em]">SWIPE · ← →</span>
        </div>
      </div>
    </div>
  </Container>
</section>

<style is:global>
  [data-team-track]::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-team-carousel]");
  const AUTOPLAY_MS = 5000;

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  carousels.forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-team-track]");
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-team-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-team-next]");
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-team-card]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-team-dot]"));
    const counter = root.querySelector<HTMLElement>("[data-team-current]");
    if (!track || !prevBtn || !nextBtn || cards.length === 0) return;

    let activeIndex = 0;
    let autoplayId: number | null = null;
    let autoplayPaused = false;

    const updateActive = (index: number) => {
      activeIndex = Math.max(0, Math.min(cards.length - 1, index));
      cards.forEach((c, i) => {
        c.querySelector("article")?.setAttribute("data-active", i === activeIndex ? "true" : "false");
      });
      dots.forEach((d, i) => {
        d.setAttribute("data-active", i === activeIndex ? "true" : "false");
      });
      if (counter) counter.textContent = (activeIndex + 1).toString();
      prevBtn.disabled = activeIndex === 0;
      nextBtn.disabled = activeIndex === cards.length - 1;
    };

    const scrollToIndex = (index: number) => {
      const target = cards[index];
      if (!target) return;
      const trackRect = track.getBoundingClientRect();
      const cardRect = target.getBoundingClientRect();
      const offset = cardRect.left - trackRect.left - (trackRect.width - cardRect.width) / 2;
      track.scrollBy({ left: offset, behavior: prefersReducedMotion ? "auto" : "smooth" });
    };

    const goNext = () => {
      const next = activeIndex === cards.length - 1 ? 0 : activeIndex + 1;
      scrollToIndex(next);
      updateActive(next);
    };

    const goPrev = () => {
      const next = activeIndex === 0 ? cards.length - 1 : activeIndex - 1;
      scrollToIndex(next);
      updateActive(next);
    };

    const startAutoplay = () => {
      if (prefersReducedMotion || autoplayPaused) return;
      stopAutoplay();
      autoplayId = window.setInterval(goNext, AUTOPLAY_MS);
    };

    const stopAutoplay = () => {
      if (autoplayId !== null) {
        window.clearInterval(autoplayId);
        autoplayId = null;
      }
    };

    const resetAutoplay = () => {
      stopAutoplay();
      startAutoplay();
    };

    prevBtn.addEventListener("click", () => {
      goPrev();
      resetAutoplay();
    });

    nextBtn.addEventListener("click", () => {
      goNext();
      resetAutoplay();
    });

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        scrollToIndex(i);
        updateActive(i);
        resetAutoplay();
      });
    });

    track.addEventListener("pointerdown", () => {
      stopAutoplay();
    });
    track.addEventListener("pointerup", () => {
      startAutoplay();
    });
    track.addEventListener("pointercancel", () => {
      startAutoplay();
    });

    root.addEventListener("mouseenter", () => {
      autoplayPaused = true;
      stopAutoplay();
    });
    root.addEventListener("mouseleave", () => {
      autoplayPaused = false;
      startAutoplay();
    });

    root.addEventListener("focusin", () => {
      autoplayPaused = true;
      stopAutoplay();
    });
    root.addEventListener("focusout", (e: Event) => {
      const fe = e as FocusEvent;
      if (!root.contains(fe.relatedTarget as Node | null)) {
        autoplayPaused = false;
        startAutoplay();
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopAutoplay();
      } else if (!autoplayPaused) {
        startAutoplay();
      }
    });

    if ("IntersectionObserver" in window) {
      const obs = new IntersectionObserver(
        (entries: IntersectionObserverEntry[]) => {
          let bestEntry: IntersectionObserverEntry | null = null;
          for (const entry of entries) {
            const current = bestEntry as IntersectionObserverEntry | null;
            if (!current || entry.intersectionRatio > current.intersectionRatio) {
              bestEntry = entry;
            }
          }
          const candidate = bestEntry as IntersectionObserverEntry | null;
          if (candidate && candidate.isIntersecting && candidate.intersectionRatio > 0.55) {
            const idx = cards.indexOf(candidate.target as HTMLElement);
            if (idx >= 0) updateActive(idx);
          }
        },
        { root: track, threshold: [0.4, 0.55, 0.7], rootMargin: "0px" }
      );
      cards.forEach((c) => obs.observe(c));
    }

    root.addEventListener("keydown", (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === "ArrowRight") {
        ke.preventDefault();
        goNext();
        resetAutoplay();
      } else if (ke.key === "ArrowLeft") {
        ke.preventDefault();
        goPrev();
        resetAutoplay();
      }
    });

    updateActive(0);
    startAutoplay();
  });
</script>
