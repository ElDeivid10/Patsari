---
import Badge from "../ui/Badge.astro";
import Container from "../layout/Container.astro";
import SectionHeader from "../layout/SectionHeader.astro";
import CornerBracket from "../visuals/CornerBracket.astro";
import TelemetrySparkline from "../visuals/TelemetrySparkline.astro";

interface Capability {
  code: string;
  title: string;
  description: string;
  status: "nominal" | "standby" | "telemetry";
  metric: string;
  pin: string;
  sparkData?: number[];
}

const capabilities: Capability[] = [
  {
    code: "MOD-01",
    title: "Navegación inercial",
    description: "Acelerómetro, giroscopio y magnetómetro de 9 ejes vía BNO085. Rango ±16 g para registrar los esfuerzos del lanzamiento y descenso. Aceleración en g con 2 decimales para la trama.",
    status: "nominal",
    metric: "±16 g · 2000 °/s",
    pin: "I²C · A4/A5",
    sparkData: [22, 28, 24, 31, 28, 35, 32, 38, 36, 42, 39, 46, 44, 51, 48, 55, 52],
  },
  {
    code: "MOD-02",
    title: "Sensado ambiental",
    description: "Presión barométrica, temperatura, humedad relativa y resistencia de gas (indicador VOC). Altitud relativa calculada con presión de referencia capturada al inicio de la misión.",
    status: "telemetry",
    metric: "300–1100 hPa · −40…85 °C",
    pin: "I²C · A4/A5",
    sparkData: [38, 35, 42, 39, 45, 42, 48, 46, 52, 49, 55, 53, 58, 55, 62, 59, 65],
  },
  {
    code: "MOD-03",
    title: "Geoposicionamiento",
    description: "Receptor GPS NEO-6M conectado por UART a 9600 bps. Entrega latitud y longitud con estado de fix; sin fix transmite 0.000000,0.000000 sin bloquear el ciclo principal.",
    status: "nominal",
    metric: "NEO-6M · 10 Hz",
    pin: "UART · D4/D5",
    sparkData: [12, 15, 18, 22, 19, 25, 28, 32, 29, 35, 38, 42, 39, 45, 48, 52, 49],
  },
  {
    code: "MOD-04",
    title: "Enlace LoRa 1 Hz",
    description: "Transmisor SX1278 a ~433 MHz compartido en SPI con la microSD. Selección independiente por CS: D9 para LoRa, D10 para SD. Misma cadena ASCII se transmite y se guarda.",
    status: "nominal",
    metric: "PA +14 dBm · SF7/BW125",
    pin: "SPI · CS=D9",
    sparkData: [45, 42, 48, 52, 49, 55, 58, 62, 59, 65, 68, 72, 69, 75, 78, 82, 79],
  },
  {
    code: "MOD-05",
    title: "Registro redundante",
    description: "Lector microSD en SPI con CS=D10. Genera TELEMETRY.CSV con encabezado de 21 columnas y una línea por paquete. Verifica disponibilidad antes de cada escritura.",
    status: "nominal",
    metric: "CSV · FAT32 · 1 línea/seg",
    pin: "SPI · CS=D10",
    sparkData: [28, 32, 29, 35, 38, 34, 41, 38, 44, 42, 48, 45, 51, 48, 54, 52, 58],
  },
  {
    code: "MOD-06",
    title: "Máquina de estados",
    description: "Detector de fases WAIT → DESC → LAND por umbral de altitud, tendencia sostenida y estabilidad temporal. LAND es terminal y se conserva durante el resto de la misión.",
    status: "telemetry",
    metric: "WAIT · DESC · LAND",
    pin: "lógica · millis()",
    sparkData: [88, 89, 91, 92, 94, 93, 95, 96, 97, 96, 98, 97, 99, 98, 99, 99, 99],
  },
];
---

<section id="capacidades" class="relative py-20 md:py-28 border-t border-[var(--color-border)]">
  <Container>
    <div class="flex flex-col gap-14">
      <SectionHeader
        code="MOD-00"
        title="Seis módulos instrumentales del prototipo"
        description="Cada módulo es una unidad funcional con su bus, pinout y tipo de dato asignado. La lista refleja literalmente los componentes soldados en la placa del PROBE-01."
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-border)] border border-[var(--color-border)] rounded-lg overflow-hidden">
        {capabilities.map((cap) => (
          <article
            class="group relative bg-[var(--color-surface)] p-7 flex flex-col gap-5 hover:bg-[var(--color-surface-sunk)] transition-colors duration-200"
          >
            <div class="absolute top-3 right-3">
              <CornerBracket position="tr" />
            </div>
            <div class="absolute bottom-3 left-3 opacity-0 group-hover:opacity-100 transition-opacity">
              <CornerBracket position="bl" />
            </div>

            <div class="flex items-center justify-between">
              <span class="label-sm text-[var(--color-text-muted)] tracking-[0.12em]">
                [{cap.code}]
              </span>
              <Badge variant={cap.status} size="sm">
                {cap.status === "nominal" ? "Operativo" : cap.status === "telemetry" ? "Live" : "Calibración"}
              </Badge>
            </div>

            <div class="flex flex-col gap-2 flex-1">
              <h3 class="font-display font-semibold text-[1.25rem] leading-tight tracking-[-0.01em] text-[var(--color-text-primary)]">
                {cap.title}
              </h3>
              <p class="body-md text-[var(--color-text-secondary)] leading-relaxed">
                {cap.description}
              </p>
            </div>

            <div class="pt-4 border-t border-[var(--color-border)] flex flex-col gap-3">
              <div class="flex items-center justify-between gap-3">
                <span class="label-sm text-[var(--color-text-secondary)]">Spec</span>
                <span class="label-sm text-[var(--color-text-primary)] font-medium text-right">{cap.metric}</span>
              </div>
              <div class="flex items-center justify-between gap-3">
                <span class="label-sm text-[var(--color-text-muted)]">Bus / pin</span>
                <span class="label-sm text-[var(--color-primary-hover)] font-mono">{cap.pin}</span>
              </div>
              <div class="h-7 -mx-1 mt-1">
                {cap.sparkData && <TelemetrySparkline data={cap.sparkData} variant="sage" />}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>
