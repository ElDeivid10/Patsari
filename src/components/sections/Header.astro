---
import Button from "../ui/Button.astro";
import StatusDot from "../ui/StatusDot.astro";
import Container from "../layout/Container.astro";

const navLinks = [
  { href: "#capacidades", label: "Módulos" },
  { href: "#mision", label: "Estados" },
  { href: "#proyectos", label: "Bitácora" },
  { href: "#equipo", label: "Equipo" },
  { href: "#tecnologia", label: "Hardware" }
];
---

<header
  class="sticky top-0 z-50 bg-[var(--color-canvas)]/85 backdrop-blur-md border-b border-[var(--color-border)]"
>
  <Container>
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="relative w-7 h-7 flex items-center justify-center">
          <svg viewBox="0 0 28 28" class="w-7 h-7">
            <rect x="3" y="5" width="22" height="18" rx="1.5" fill="none" stroke="#283e06" stroke-width="1.5"></rect>
            <line x1="3" y1="11" x2="25" y2="11" stroke="#283e06" stroke-width="1"></line>
            <line x1="11" y1="5" x2="11" y2="23" stroke="#3b5110" stroke-width="0.8"></line>
            <line x1="17" y1="5" x2="17" y2="23" stroke="#3b5110" stroke-width="0.8"></line>
            <circle cx="14" cy="16" r="2.5" fill="#283e06"></circle>
            <circle cx="14" cy="16" r="4" fill="none" stroke="#b7cd7f" stroke-width="0.7"></circle>
          </svg>
        </span>
        <div class="flex flex-col leading-none">
          <span class="font-display font-bold text-[1.05rem] tracking-[-0.02em] text-[var(--color-text-primary)]">
            Patsani
          </span>
          <span class="label-sm text-[var(--color-text-muted)] mt-0.5 hidden sm:block">
            TEAM 0001 · PROBE v1.0
          </span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="relative px-3 h-16 flex items-center font-mono text-[0.75rem] font-medium uppercase tracking-[0.06em] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors duration-150 group"
          >
            <span class="relative">
              {link.label}
              <span class="absolute -bottom-1 left-0 right-0 h-px bg-[var(--color-primary)] scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-200"></span>
            </span>
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <div class="hidden md:flex items-center gap-2 px-2.5 h-8 bg-[var(--color-surface-sunk)] border border-[var(--color-border)] rounded-sm">
          <StatusDot variant="nominal" size="sm" pulse />
          <span class="label-sm text-[var(--color-text-secondary)]">WAIT</span>
        </div>
        <Button variant="secondary" size="sm" class="hidden md:inline-flex">
          TELEMETRY.CSV
        </Button>
        <Button variant="primary" size="sm" href="#contacto">
          Contacto
        </Button>
      </div>
    </div>
  </Container>
</header>
