---
interface Props {
  data?: number[];
  variant?: "primary" | "sage" | "dual";
  width?: number;
  height?: number;
  class?: string;
}

const {
  data = [12, 18, 15, 22, 19, 28, 32, 26, 35, 31, 38, 34, 42, 39, 48, 45, 52],
  variant = "primary",
  width = 200,
  height = 60,
  class: className = "",
} = Astro.props;

const max = Math.max(...data);
const min = Math.min(...data);
const range = max - min || 1;
const stepX = width / (data.length - 1);

const points = data.map((v, i) => ({
  x: i * stepX,
  y: height - ((v - min) / range) * (height - 8) - 4,
}));

const pathD = points.map((p, i) => `${i === 0 ? "M" : "L"} ${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(" ");

const areaD = `${pathD} L ${width} ${height} L 0 ${height} Z`;

const stroke =
  variant === "sage"
    ? "#b7cd7f"
    : variant === "dual"
      ? "#3b5110"
      : "#283e06";
const fill =
  variant === "sage"
    ? "rgba(183, 205, 127, 0.18)"
    : variant === "dual"
      ? "rgba(59, 81, 16, 0.15)"
      : "rgba(40, 62, 6, 0.12)";
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="none"
  class={`w-full h-full ${className}`}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`spark-grad-${variant}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={fill}></stop>
      <stop offset="100%" stop-color="transparent"></stop>
    </linearGradient>
  </defs>

  <line
    x1="0"
    y1={height / 2}
    x2={width}
    y2={height / 2}
    stroke="#dce5d3"
    stroke-width="0.5"
    stroke-dasharray="2 3"
  ></line>

  <path d={areaD} fill={`url(#spark-grad-${variant})`}></path>

  <path
    d={pathD}
    fill="none"
    stroke={stroke}
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>

  {points.length > 0 && (
    <>
      <circle
        cx={points[points.length - 1].x}
        cy={points[points.length - 1].y}
        r="2.5"
        fill={stroke}
      ></circle>
      <circle
        cx={points[points.length - 1].x}
        cy={points[points.length - 1].y}
        r="4"
        fill="none"
        stroke={stroke}
        stroke-width="0.5"
        opacity="0.5"
      ></circle>
    </>
  )}
</svg>
