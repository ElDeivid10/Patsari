---
interface Props {
  variant?: "hero" | "compact";
  class?: string;
}

const { variant = "hero", class: className = "" } = Astro.props;
---

<div class={`relative w-full ${variant === "hero" ? "aspect-square max-w-[560px] mx-auto" : "aspect-[4/3]"} ${className}`} aria-hidden="true">
  <svg
    viewBox="0 0 600 600"
    preserveAspectRatio="xMidYMid meet"
    class="w-full h-full"
  >
    <defs>
      <radialGradient id="earth-grad" cx="40%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#d0ed9b"></stop>
        <stop offset="55%" stop-color="#3b5110"></stop>
        <stop offset="100%" stop-color="#162700"></stop>
      </radialGradient>
      <radialGradient id="earth-halo" cx="50%" cy="50%" r="55%">
        <stop offset="60%" stop-color="#b7cd7f" stop-opacity="0.22"></stop>
        <stop offset="100%" stop-color="#b7cd7f" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="atmosphere-grad" cx="50%" cy="50%" r="50%">
        <stop offset="82%" stop-color="#b7cd7f" stop-opacity="0"></stop>
        <stop offset="94%" stop-color="#b7cd7f" stop-opacity="0.5"></stop>
        <stop offset="100%" stop-color="#b7cd7f" stop-opacity="0"></stop>
      </radialGradient>
      <pattern id="earth-grid" width="16" height="16" patternUnits="userSpaceOnUse">
        <circle cx="0" cy="0" r="0.7" fill="#b7cd7f" opacity="0.55"></circle>
      </pattern>
    </defs>

    <g transform="translate(300 300)">
      <circle r="220" fill="url(#earth-halo)"></circle>

      <g>
        <ellipse
          cx="0"
          cy="0"
          rx="220"
          ry="80"
          fill="none"
          stroke="#3b5110"
          stroke-width="1"
          opacity="0.5"
          transform="rotate(-18)"
        ></ellipse>
        <animateTransform
          attributeName="transform"
          type="rotate"
          from="0"
          to="360"
          dur="90s"
          repeatCount="indefinite"
          additive="sum"
        />
        <circle cx="216" cy="-29" r="3.5" fill="#3b5110"></circle>
      </g>

      <g>
        <ellipse
          cx="0"
          cy="0"
          rx="180"
          ry="180"
          fill="none"
          stroke="#b7cd7f"
          stroke-width="0.8"
          opacity="0.65"
          stroke-dasharray="3 4"
        ></ellipse>
        <animateTransform
          attributeName="transform"
          type="rotate"
          from="0"
          to="360"
          dur="60s"
          repeatCount="indefinite"
        />
        <circle cx="180" cy="0" r="4.5" fill="#283e06"></circle>
        <circle cx="180" cy="0" r="9" fill="none" stroke="#b7cd7f" stroke-width="0.7"></circle>
        <line x1="180" y1="0" x2="0" y2="0" stroke="#b7cd7f" stroke-width="0.5" stroke-dasharray="2 3" opacity="0.55"></line>
        <rect x="-3" y="-3" width="6" height="6" fill="#3b5110" transform="translate(-127 -127)"></rect>
      </g>

      <g>
        <ellipse
          cx="0"
          cy="0"
          rx="150"
          ry="240"
          fill="none"
          stroke="#283e06"
          stroke-width="0.8"
          opacity="0.55"
          transform="rotate(35)"
        ></ellipse>
        <animateTransform
          attributeName="transform"
          type="rotate"
          from="35"
          to="-325"
          dur="120s"
          repeatCount="indefinite"
        />
        <circle cx="120" cy="170" r="3.5" fill="#283e06"></circle>
      </g>

      <g>
        <ellipse
          cx="0"
          cy="0"
          rx="260"
          ry="110"
          fill="none"
          stroke="#b7cd7f"
          stroke-width="0.6"
          opacity="0.45"
          stroke-dasharray="2 5"
          transform="rotate(60)"
        ></ellipse>
        <animateTransform
          attributeName="transform"
          type="rotate"
          from="60"
          to="420"
          dur="150s"
          repeatCount="indefinite"
        />
        <circle cx="-100" cy="-225" r="2.5" fill="#3b5110"></circle>
      </g>

      <circle r="105" fill="url(#earth-halo)"></circle>
      <circle r="98" fill="url(#earth-grad)"></circle>
      <circle r="98" fill="url(#earth-grid)" opacity="0.55"></circle>

      <circle r="98" fill="none" stroke="#b7cd7f" stroke-width="0.6" opacity="0.7"></circle>
      <circle r="105" fill="none" stroke="url(#atmosphere-grad)" stroke-width="12"></circle>

      <g opacity="0.55">
        <path d="M -42 -48 Q -10 -60 22 -45 T 52 -20" stroke="#b7cd7f" stroke-width="1.2" fill="none"></path>
        <path d="M -52 12 Q -20 22 12 12 T 42 32" stroke="#b7cd7f" stroke-width="1.2" fill="none" opacity="0.6"></path>
        <path d="M -32 42 Q 0 52 30 42" stroke="#b7cd7f" stroke-width="1.2" fill="none" opacity="0.5"></path>
        <path d="M -60 -18 Q -40 -10 -20 -22" stroke="#b7cd7f" stroke-width="0.8" fill="none" opacity="0.4"></path>
      </g>

      <g transform="translate(98 0)">
        <animateTransform
          attributeName="transform"
          type="rotate"
          from="0"
          to="360"
          dur="40s"
          repeatCount="indefinite"
          additive="sum"
        />
        <circle r="3" fill="#283e06"></circle>
        <circle r="6" fill="none" stroke="#b7cd7f" stroke-width="0.5"></circle>
      </g>
    </g>

    <g font-family="JetBrains Mono, monospace" font-size="10" fill="#424b3e">
      <text x="540" y="118" letter-spacing="0.5">42.3°N</text>
      <text x="540" y="132" letter-spacing="0.5">14.8°W</text>
      <line x1="510" y1="122" x2="535" y2="122" stroke="#b7cd7f" stroke-width="0.6"></line>
    </g>

    <g font-family="JetBrains Mono, monospace" font-size="9" fill="#283e06">
      <text x="40" y="458" letter-spacing="0.5">ALT 547km</text>
      <text x="40" y="472" letter-spacing="0.5">VEL 7.66km/s</text>
      <line x1="32" y1="440" x2="32" y2="480" stroke="#b7cd7f" stroke-width="0.6"></line>
      <line x1="28" y1="450" x2="44" y2="450" stroke="#b7cd7f" stroke-width="0.6"></line>
    </g>

    <g font-family="JetBrains Mono, monospace" font-size="9" fill="#424b3e">
      <text x="450" y="500" letter-spacing="0.5">SENSOR-04</text>
      <text x="450" y="512" letter-spacing="0.5">SPEC-B</text>
      <circle cx="440" cy="497" r="2.2" fill="#3b5110"></circle>
      <circle cx="440" cy="497" r="5" fill="none" stroke="#3b5110" stroke-width="0.4" opacity="0.4">
        <animate attributeName="r" values="2.2;8;2.2" dur="2.6s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0.6;0;0.6" dur="2.6s" repeatCount="indefinite" />
      </circle>
    </g>

    <g stroke="#b7cd7f" stroke-width="1" fill="none" opacity="0.65">
      <path d="M 20 20 L 20 42 M 20 20 L 42 20"></path>
      <path d="M 580 580 L 580 558 M 580 580 L 558 580"></path>
      <path d="M 20 580 L 20 558 M 20 580 L 42 580"></path>
      <path d="M 580 20 L 580 42 M 580 20 L 558 20"></path>
    </g>

    <g font-family="JetBrains Mono, monospace" font-size="8" fill="#75796b">
      <text x="20" y="595" letter-spacing="1">PAYLOAD ORBIT-04 // SCAN MODE</text>
    </g>
  </svg>

  <div class="absolute inset-x-0 top-0 h-px anim-scan bg-gradient-to-r from-transparent via-[var(--color-sage)] to-transparent pointer-events-none"></div>
</div>
