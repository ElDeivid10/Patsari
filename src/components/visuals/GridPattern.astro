---
interface Props {
  size?: number;
  color?: string;
  opacity?: number;
  fade?: boolean;
  class?: string;
}

const {
  size = 32,
  color = "#dce5d3",
  opacity = 0.6,
  fade = true,
  class: className = "",
} = Astro.props;

const maskId = `grid-fade-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`absolute inset-0 pointer-events-none ${className}`} aria-hidden="true">
  <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id={maskId} width={size} height={size} patternUnits="userSpaceOnUse">
        <path
          d={`M ${size} 0 L 0 0 0 ${size}`}
          fill="none"
          stroke={color}
          stroke-width="1"
          opacity={opacity}
        ></path>
      </pattern>
      {fade && (
        <radialGradient id={`${maskId}-mask`} cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
          <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
        </radialGradient>
        <mask id={`${maskId}-mask-element`}>
          <rect width="100%" height="100%" fill={`url(#${maskId}-mask)`}></rect>
        </mask>
      )}
    </defs>
    <rect
      width="100%"
      height="100%"
      fill={`url(#${maskId})`}
      mask={fade ? `url(#${maskId}-mask-element)` : undefined}
    ></rect>
  </svg>
</div>
