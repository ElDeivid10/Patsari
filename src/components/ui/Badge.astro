---
interface Props {
  variant?: "nominal" | "standby" | "telemetry" | "outline";
  withDot?: boolean;
  size?: "sm" | "md";
  class?: string;
}

const {
  variant = "nominal",
  withDot = false,
  size = "md",
  class: className = "",
} = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: "h-5 px-2 text-[0.625rem]",
  md: "h-6 px-2.5 text-[0.6875rem]",
};

const variantClasses: Record<string, string> = {
  nominal:
    "bg-[var(--color-surface-sunk)] border-[var(--color-sage)] text-[var(--color-primary)]",
  standby:
    "bg-[var(--color-canvas)] border-[var(--color-border)] text-[var(--color-text-secondary)]",
  telemetry:
    "bg-[var(--color-text-primary)] border-[var(--color-text-primary)] text-[var(--color-sage)]",
  outline:
    "bg-transparent border-[var(--color-border-active)] text-[var(--color-primary)]",
};

const dotColor: Record<string, string> = {
  nominal: "bg-[var(--color-primary-hover)]",
  standby: "bg-[var(--color-text-muted)]",
  telemetry: "bg-[var(--color-sage)]",
  outline: "bg-[var(--color-primary)]",
};

const baseClasses = `inline-flex items-center gap-1.5 font-mono font-medium uppercase tracking-[0.08em] rounded-sm border whitespace-nowrap ${sizeClasses[size]} ${variantClasses[variant]} ${className}`;
---

<span class={baseClasses}>
  {withDot && (
    <span class={`w-1.5 h-1.5 rounded-full ${dotColor[variant]} anim-pulse-dot`}></span>
  )}
  <slot />
</span>
